# Environment variables – copy to .env and fill in values

# Server
PORT=3000

# Email (SMTP) settings for sending job applications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Job Searcher <your-email@gmail.com>"

# Playwright (optional) – set to "true" to run browsers headlessly (default)
HEADLESS=true
